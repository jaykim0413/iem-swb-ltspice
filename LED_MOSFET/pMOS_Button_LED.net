M1 N002 IN N004 N004 PM
V1 N004 0 3.3
R1 N001 N002 470
D1 N001 0 LEDx
S1 IN 0 press 0 SW
V2 N003 0 3.3
R2 IN N003 {Rpu}
C1 0 IN 8.5p
V3 press 0 PWL(0 0 1m 0 1.05m 3.3 1.08m 0 1.12m 3.3 1.15m 0 1.2m 3.3 50m 3.3 50.05m 0 50.08m 3.3 50.12m 0 50.15m 3.3 50.20m 0 100m 0)
.model D D
.lib C:\Users\jaykim\AppData\Local\LTspice\lib\cmp\standard.dio
.model NMOS NMOS
.model PMOS PMOS
.lib C:\Users\jaykim\AppData\Local\LTspice\lib\cmp\standard.mos
.model SW SW(Ron=0.1 Roff=1G Vt=1.65 Vh=0.1)
.model PM PMOS(Vto=-1 Kp=0.2)
.model LEDx D(Is=1e-20 N=1.8 Rs=5)
.param Rpu 100k
.tran 100m
.meas TRAN I_pressed AVG I(D1) FROM=5m TO=45m
.meas TRAN I_released AVG I(D1) FROM=60m TO=95m
.meas TRAN V_in_pressed AVG V(IN) FROM=5m TO=45m
.meas TRAN t_press WHEN V(press)=1.65 RISE=1
.meas TRAN t_led_on WHEN I(D1)=1m RISE=1
.backanno
.end
